{
  "name": "base",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --no-warnings --import ./tests/resolve-alias.mjs --experimental-strip-types --test tests/*.test.mts",
    "ios": "open ios/App/App.xcodeproj",
    "mac:gen": "cd macos && xcodegen generate",
    "mac": "cd macos && xcodegen generate && open Base.xcodeproj",
    "mac:install": "./scripts/install_mac.sh",
    "mac:release": "./scripts/release_mac.sh",
    "desktop:dev": "npm run tauri -w @base/desktop -- dev",
    "desktop:build": "npm run tauri -w @base/desktop -- build",
    "desktop:frontend": "npm run build -w @base/desktop",
    "desktop:typecheck": "npm run typecheck -w @base/desktop",
    "desktop:check": "cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "cloud:dev": "npm run dev -w @base/cloud",
    "cloud:check": "npm run check -w @base/cloud",
    "cloud:build": "npm run build -w @base/cloud",
    "workspace:test": "cargo test --manifest-path native/BaseWorkspace/Cargo.toml",
    "workspace:bundle": "node scripts/build-workspace.mjs",
    "cloud:configure": "node scripts/configure-cloud.mjs",
    "cloud:test-runtime": "node --experimental-strip-types scripts/test-cloud-runtime.mts",
    "web:build": "npm run build -w @base/web",
    "web:typecheck": "npm run typecheck -w @base/web",
    "web:dev": "npm run dev -w @base/web"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-virtual": "^3.14.14",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.4.1",
    "@vercel/kv": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "motion": "^14.1.0",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "braces": "3.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "undici@^6": "6.29.1",
    "undici@^7": "7.30.1",
    "zod@^4": "4.6.7"
  },
  "workspaces": [
    "vendor/braces",
    "apps/desktop",
    "apps/cloud",
    "packages/*",
    "apps/web"
  ]
}
