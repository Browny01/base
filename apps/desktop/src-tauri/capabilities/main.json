{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled main window can call narrow Base services.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "deep-link:allow-get-current",
    "allow-load-workspace",
    "allow-commit-local",
    "allow-apply-sync",
    "allow-resolve-conflict",
    "allow-connect-account",
    "allow-disconnect-account",
    "allow-api-request",
    "allow-open-external",
    "allow-export-workspace",
    "allow-notification-permission",
    "allow-send-notification",
    "allow-check-update",
    "allow-install-update",
    "allow-print-document",
    "allow-cache-media",
    "allow-shutdown-ready",
    "allow-finish-exit",
    "allow-close-window",
    "allow-import-workspace",
    "allow-list-offline-workspaces",
    "allow-activate-offline-workspace",
    "allow-read-offline-source",
    "allow-verify-note-password",
    "allow-set-local-note-password",
    "allow-record-frontend-ready",
    "allow-record-scroll-sample",
    "allow-workspace-service-start",
    "allow-workspace-service-stop",
    "allow-workspace-service-status",
    "allow-workspace-service-autostart",
    "allow-connect-hosted-workspace",
    "allow-cloud-sign-in-start",
    "allow-cloud-sign-in-finish",
    "allow-cloud-workspace-open",
    "allow-download-workspace-file",
    "allow-integration-status",
    "allow-set-integration-key"
  ]
}
